# Supabase Configuration
# Local:  http://127.0.0.1:54321 (via `supabase start`)
# Hosted: https://xxxx.supabase.co (from dashboard → Settings → API)
# Do not paste angle brackets. `https://<project-ref>.supabase.co` is not a valid URL.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-here

# Storage Configuration
STORAGE_BUCKET=brand-assets

# Admin Configuration
ADMIN_EMAILS=admin@example.com

# CORS Configuration
# Comma-separated list of allowed origins (must match the host:port you expose)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost

# Server Configuration (local / Docker)
# HOST is local-dev only. Docker entrypoint uses BACKEND_HOST (default 127.0.0.1).
HOST=127.0.0.1
# Internal FastAPI port inside the container (default 8000). If it equals the
# public FRONTEND_PORT / platform PORT, the entrypoint moves the API to 8001.
BACKEND_PORT=8000
# Do NOT set PORT=8000 on Render. Render's PORT is the public HTTP port for
# Next.js. Pasting PORT=8000 makes the platform probe 8000 while Next was on 3000.

# Document only; signup is gated in the Next.js app.
# Production: set NEXT_PUBLIC_SIGNUPS_ENABLED=false in the frontend build env.