# Supabase Configuration (Client-side)
# Local:  http://127.0.0.1:54321 (via `supabase start`)
# Hosted: https://<project-ref>.supabase.co (from dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# API Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_SERVER_API_URL=http://127.0.0.1:8000
# Optional alias used by server-side fetches. Defaults to NEXT_SERVER_API_URL.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Signups gate. Set to "false" in production builds to disable /signup.
# When false, the signup page renders a closed-state card and never calls supabase.auth.signUp.
# Docker production default is false. Local Next.js default (unset or true) keeps the form.
NEXT_PUBLIC_SIGNUPS_ENABLED=true